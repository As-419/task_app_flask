# ============================================================================
#  Modèle de configuration — copiez ce fichier en `.env` puis adaptez les valeurs
#      cp .env.example .env
#  Le fichier `.env` contient des secrets : il N'EST PAS versionné (voir .gitignore).
# ============================================================================

# Clé secrète Flask (sessions, protection CSRF).
# En production, générez une vraie clé :  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-a-changer-en-production

# Choix de la configuration : development | testing | production
FLASK_CONFIG=development

# --- Base de données PostgreSQL ---------------------------------------------
# Ces trois variables servent à créer le conteneur Postgres (docker compose).
POSTGRES_USER=taskapp
POSTGRES_PASSWORD=taskapp
POSTGRES_DB=taskapp

# URL de connexion utilisée par l'application.
#  - En LOCAL (sans Docker)          : l'hôte est "localhost"
#  - Dans Docker (docker compose up) : compose remplace automatiquement l'hôte par "db"
DATABASE_URL=postgresql://taskapp:taskapp@localhost:5432/taskapp
